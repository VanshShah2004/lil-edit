# Copy to backend/.env and fill in real values. Never commit the real .env file.

# --- Server ---
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed frontend origins. Only needed if the frontend
# is hosted on a different origin than this API (split hosting). In the combined
# deployment (SERVE_FRONTEND=true, same origin) this can be left unset.
CORS_ORIGIN=https://yourdomain.com

# --- Combined deployment: serve the built frontend from this server ---
# Set to "true" to have this Express server also serve lil-edit's built SPA
# (with per-product Open Graph tag injection for link previews). Requires the
# frontend to already be built (npm run build in lil-edit/) before this server starts.
SERVE_FRONTEND=true
# Optional override; defaults to ../lil-edit/dist relative to this file.
# FRONTEND_DIST_DIR=

# Public origin of the deployed site. Used to build absolute links in emails
# and Open Graph tags. Falls back to the first CORS_ORIGIN entry, then localhost.
PUBLIC_SITE_URL=https://yourdomain.com

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Order confirmation email (Gmail SMTP via nodemailer) ---
# GMAIL_APP_PASSWORD is a Gmail "app password", not the account password.
# If unset, email sending is a no-op (order placement still succeeds).
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=
MAIL_REPLY_TO=

# --- Redis (optional L2 cache; falls back to in-memory if unset) ---
REDIS_URL=
