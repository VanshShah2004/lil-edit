# Copy to lil-edit/.env.local and fill in real values. Never commit the real file.
# All VITE_* vars are baked into the build at build time (not read at runtime).

# --- Dev server ---
# Port for `vite` dev server. Falls back to 5174 if unset.
VITE_PORT=5174

# --- Supabase (client-side reads go directly to Supabase for some data) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Firebase (phone-auth OTP) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Razorpay (optional; backend also returns this from /api/checkout/initiate) ---
VITE_RAZORPAY_KEY_ID=

# --- Optional ---
VITE_IMAGE_CDN_BASE=
VITE_DEBUG_CACHE=

# --- API base URL(s) — leave BOTH unset for the combined deployment ---
# (backend serves this built frontend from the same origin, SERVE_FRONTEND=true).
# Only set these if the frontend is hosted separately from the backend (split hosting):
# VITE_API_URL=https://api.yourdomain.com
# VITE_BACKEND_URL=https://api.yourdomain.com
